<!doctype html>

<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seoul Voice - Panel principal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Seoul Voice</a>
    <div class="d-flex">
      <span class="navbar-text me-3">
        Bienvenido, <%= user ? user.username : 'invitado' %>
      </span>
      <a class="btn btn-outline-danger" href="/logout">Cerrar sesión</a>
    </div>
  </div>
</nav>

<div class="container py-4">
  <h1>Panel principal</h1>
  <p>Selecciona una opción para continuar.</p>

  <div class="row mt-4">
    <div class="col-md-6 mb-3">
      <a href="/cine" class="btn btn-primary w-100 p-3">Mini Cine</a>
    </div>
    <div class="col-md-6 mb-3">
      <a href="/karaoke" class="btn btn-success w-100 p-3">Karaoke</a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
