<!doctype html>

<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seoul Voice - Karaoke</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Seoul Voice</a>
    <div class="d-flex">
      <span class="navbar-text me-3">
        Bienvenido, <%= user ? user.username : 'invitado' %>
      </span>
      <a class="btn btn-outline-danger" href="/logout">Cerrar sesión</a>
    </div>
  </div>
</nav>

<div class="container py-4">
  <h2>Karaoke</h2>

<button id="startBtn" class="btn btn-success mb-3">Iniciar karaoke</button>

  <div id="lyrics" class="p-3 bg-light border rounded">
    <% lyrics.forEach(function(line, idx){ %>
      <p data-idx="<%= idx %>"><%= line %></p>
    <% }); %>
  </div>
</div>

<script src="/js/karaoke.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
