<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seoul Voice</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Seoul Voice</a>
    <div class="d-flex">
      <span class="navbar-text me-3">Bienvenido, <%= user ? user.username : 'invitado' %></span>
      <a class="btn btn-outline-danger" href="/logout">Cerrar sesión</a>
    </div>
  </div>
</nav>
<div class="container py-4">

<h2>Mini Cine</h2>
<div class="mb-3">
  <label class="form-label">Selecciona un video</label>
  <select id="videoSelect" class="form-select mb-3">
    <% videos.forEach(function(v, idx) { %>
      <option value="<%= idx %>"><%= v.title %></option>
    <% }); %>
  </select>
  <div id="player">
    <video id="mp4player" width="720" controls>
      <source src="<%= videos[0].src %>" type="video/mp4">
    </video>
  </div>
</div>
<script src="/js/cine.js"></script>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
