<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Seoul Voice</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Seoul Voice</a>
    <div class="d-flex">
      <span class="navbar-text me-3">Bienvenido, <%= user ? user.username : 'invitado' %></span>
      <a class="btn btn-outline-danger" href="/logout">Cerrar sesión</a>
    </div>
  </div>
</nav>
<div class="container py-4">

<h2><%= heading %></h2>
<% if (message) { %><div class="alert alert-info"><%= message %></div><% } %>
<% if (show_form) { %>
<form method="POST">
  <div class="mb-3"><input name="name" class="form-control" placeholder="Nombre"></div>
  <button class="btn btn-primary">Guardar</button>
</form>
<% } %>
<% if (items && items.length) { %>
<ul class="list-group">
  <% items.forEach(function(item){ %>
    <li class="list-group-item"><%= item %></li>
  <% }) %>
</ul>
<% } %>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
