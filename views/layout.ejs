<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Seoul Voice</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <div class="d-flex" id="wrapper">
      <div class="border-end bg-white" id="sidebar-wrapper">
        <div class="sidebar-heading border-bottom bg-light">Seoul Voice</div>
        <div class="list-group list-group-flush">
          <a href="/" class="list-group-item list-group-item-action list-group-item-light p-3">Inicio</a>
          <a href="/cine" class="list-group-item list-group-item-action list-group-item-light p-3">Mini Cine</a>
          <a href="/karaoke" class="list-group-item list-group-item-action list-group-item-light p-3">Karaoke</a>
          <a href="/logout" class="list-group-item list-group-item-action list-group-item-light p-3">Cerrar sesión</a>
        </div>
      </div>
      <div id="page-content-wrapper" class="w-100">
        <nav class="navbar navbar-light bg-light border-bottom">
          <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <button class="btn btn-outline-secondary me-2" id="sidebarToggle" aria-label="Toggle sidebar">&#9776;</button>
              <span class="navbar-text">Bienvenido, <%= user ? user.username : 'invitado' %></span>
            </div>
            <% if (!user) { %>
              <a class="btn btn-outline-primary" href="/login" target="_blank" rel="noopener">Login</a>
            <% } %>
          </div>
        </nav>
        <div class="container-fluid mt-3">
          <%- body %>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script>
  </body>
</html>
